# Port and Host configurations for servers
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# API base URL for frontend communication
# Using 127.0.0.1 instead of localhost avoids DNS IPv6 fallback delays on Windows
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Security configurations
JWT_SECRET=supersecretjwtsecretkeychangeinproduction12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database configurations
DATABASE_URL=sqlite:///./banking.db

# Application environment
ENV=development
LOG_LEVEL=info
